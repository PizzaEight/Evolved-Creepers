execute if score dangerous_creepers.config dangerous_creepers.chance matches 4 if score dangerous_creepers.config dangerous_creepers.increasing_chance matches 50.. run scoreboard players add dangerous_creepers.config dangerous_creepers.increasing_charged_chance 1
execute if score dangerous_creepers.config dangerous_creepers.chance matches 4 if score dangerous_creepers.config dangerous_creepers.increasing_chance matches 25 run tellraw @a {color:red,text:"Evolved Creeper Chance reached 25%"}
