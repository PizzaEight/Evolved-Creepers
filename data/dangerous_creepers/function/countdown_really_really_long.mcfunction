execute if score dangerous_creepers.config dangerous_creepers.chance matches 4 if score dangerous_creepers.config dangerous_creepers.increasing_charged_chance matches 100 run tellraw @a {color:red,text:"Evolved Charged Creeper Chance reached 100%"}